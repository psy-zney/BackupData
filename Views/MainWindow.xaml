<Window x:Class="BackupUtility.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zney Backup &amp; Restore" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#FFFFFF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ZNEY BACKUP &amp; RESTORE" FontSize="20" FontWeight="Bold" Foreground="#007ACC"/>
                <TextBlock Text="Chỉ đọc file .zney. Dữ liệu được kiểm tra SHA-256 trước khi ghi đè." FontSize="12" Foreground="#AAAAAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333">
            <TabItem Header="Sao lưu" Foreground="White" FontSize="14" Padding="15,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="1. Ứng dụng đã cài" Foreground="#007ACC" Margin="5" BorderBrush="#333333">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="Quét phần mềm đã cài" Click="BtnScanApps_Click" HorizontalAlignment="Left" Background="#2D2D30"/>
                            <ListView x:Name="LvBackupApps" Background="#252526" Foreground="White" BorderThickness="0" Margin="0,5,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RestoreWorkflow}" Foreground="#007ACC" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="2. Local data" Foreground="#007ACC" Margin="5" BorderBrush="#333333">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Xuất file backup (.ZNEY)" Click="BtnCreateBackup_Click" Background="#28A745" Height="40" FontSize="15"/>
                            <ListView x:Name="LvBackupData" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding TargetPath}" Foreground="#888888" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Phục hồi" Foreground="White" FontSize="14" Padding="15,8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Chọn file backup (.zney)" Click="BtnOpenBackupFile_Click"/>
                        <TextBlock x:Name="TxtSelectedBackupFile" Text="Chưa chọn file .zney" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#FFCC00" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Ứng dụng và luồng phục hồi" Foreground="#28A745" Margin="5" BorderBrush="#333333">
                            <ListView x:Name="LvRestoreApps" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RestoreWorkflow}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding RestoreInstructions}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Local data đã niêm phong SHA-256" Foreground="#28A745" Margin="5" BorderBrush="#333333">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Phục hồi các mục đã chọn" Click="BtnStartRestore_Click" Background="#28A745" Height="40" FontSize="15"/>
                                <ListView x:Name="LvRestoreData" Background="#252526" Foreground="White" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding TargetPath}" Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding FileHashes.Count, StringFormat='Số tệp: {0}'}" Foreground="#AAAAAA" FontSize="10"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="Trạng thái và nhật ký" Foreground="#888888" BorderBrush="#333333" Margin="0,10,0,0">
            <TextBox x:Name="TxtLog" Background="#181818" Foreground="#00FF66" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
