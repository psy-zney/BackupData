<Window x:Class="BackupUtility.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#FFFFFF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource HeaderTitle}" FontSize="20" FontWeight="Bold" Foreground="#007ACC"/>
                    <TextBlock Text="{DynamicResource HeaderSubtitle}" FontSize="12" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <StackPanel x:Name="ScanProgressPanel" Visibility="Collapsed" Margin="0,10,0,0" MaxWidth="620">
                        <TextBlock x:Name="TxtScanStatus" Foreground="#FFCC00" FontSize="12" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,5,0,0" Foreground="#28A745" Background="#333333"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguageSelector" Width="115" SelectionChanged="LanguageSelector_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                        <ComboBoxItem Tag="vi-VN">Tiếng Việt</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ModeSelector" Grid.Row="1">
            <Border Background="#1E1E1E" CornerRadius="8" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ChooseMode}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ChooseModeHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#AAAAAA" Margin="0,12,0,25"/>
                    <Button x:Name="BtnChooseExport" Content="{DynamicResource ExportStart}" Click="BtnChooseExport_Click" Background="#28A745" Height="50" FontSize="16"/>
                    <Button Content="{DynamicResource ImportStart}" Click="BtnChooseImport_Click" Height="50" FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" Visibility="Collapsed">
            <TabItem Header="{DynamicResource ExportTab}" Foreground="White" FontSize="14" Padding="15,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="{DynamicResource InstalledApps}" Foreground="#007ACC" Margin="5" BorderBrush="#333333">
                        <DockPanel>
                            <Button x:Name="BtnScanItems" DockPanel.Dock="Top" Content="{DynamicResource ScanItems}" Click="BtnScanApps_Click" HorizontalAlignment="Left" Background="#2D2D30"/>
                            <ListView x:Name="LvBackupApps" Background="#252526" Foreground="White" BorderThickness="0" Margin="0,5,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RestoreWorkflow}" Foreground="#007ACC" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="{DynamicResource LocalData}" Foreground="#007ACC" Margin="5" BorderBrush="#333333">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="{DynamicResource CreateBackup}" Click="BtnCreateBackup_Click" Background="#28A745" Height="40" FontSize="15"/>
                            <ListView x:Name="LvBackupData" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding TargetPath}" Foreground="#888888" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource ImportTab}" Foreground="White" FontSize="14" Padding="15,8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{DynamicResource ChooseBackup}" Click="BtnOpenBackupFile_Click"/>
                        <TextBlock x:Name="TxtSelectedBackupFile" Text="{DynamicResource NoBackupSelected}" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#FFCC00" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="{DynamicResource RestoreApps}" Foreground="#28A745" Margin="5" BorderBrush="#333333">
                            <ListView x:Name="LvRestoreApps" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RestoreWorkflow}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding RestoreInstructions}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="{DynamicResource RestoreData}" Foreground="#28A745" Margin="5" BorderBrush="#333333">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="{DynamicResource RestoreSelected}" Click="BtnStartRestore_Click" Background="#28A745" Height="40" FontSize="15"/>
                                <ListView x:Name="LvRestoreData" Background="#252526" Foreground="White" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Foreground="#007ACC" FontSize="11"/>
                                                <TextBlock Text="{Binding TargetPath}" Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding FileHashes.Count, StringFormat='Số tệp: {0}'}" Foreground="#AAAAAA" FontSize="10"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="{DynamicResource StatusLog}" Foreground="#888888" BorderBrush="#333333" Margin="0,10,0,0">
            <TextBox x:Name="TxtLog" Background="#181818" Foreground="#00FF66" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
